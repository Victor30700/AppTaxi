# Identidad de la instancia (1 despliegue = 1 empresa/sindicato)
COMPANY_NAME="Radio Movil Central"
PORT=3000

# Base de datos PostgreSQL + PostGIS (Supabase) y Schema dedicado
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-1-us-east-2.pooler.supabase.com:5432/postgres
DB_SCHEMA=taxiapp

# Supabase Auth & Storage (@supabase/server — llaves modernas, sin legacy keys)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
SUPABASE_SECRET_KEY=sb_secret_your-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_AVATARS_BUCKET=avatars
SUPABASE_DOCUMENTS_BUCKET=driver-documents

# Redis (radar GPS en RAM, locks de despacho, BullMQ y adaptador Socket.io)
REDIS_HOST=localhost
REDIS_PORT=6379

# Google Maps Platform (Routes API en backend)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Firebase Cloud Messaging (notificaciones push para despertar app del conductor)
FCM_PROJECT_ID=your-firebase-project-id
FCM_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Pasarela de Pagos QR Dinámico (validación de webhook)
QR_GATEWAY_WEBHOOK_SECRET=your-qr-webhook-secret
