# Puerto de ejecución del servidor NestJS
PORT=3000

# Base de datos PostgreSQL + PostGIS (Supabase)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Supabase Storage (para fotos de perfil, identificación y vehículos)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=taxiapp-media

# Redis (ubicaciones en tiempo real y adaptador WebSocket)
REDIS_HOST=localhost
REDIS_PORT=6379
